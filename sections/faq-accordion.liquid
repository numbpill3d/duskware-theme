{{ 'section-faq-accordion.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="dw-faq color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width dw-faq__inner">
    {%- if section.settings.heading != blank -%}
      <div class="dw-faq__head">
        {%- if section.settings.eyebrow != blank -%}
          <p class="dw-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h1 class="dw-faq__heading">{{ section.settings.heading | escape }}</h1>
      </div>
    {%- endif -%}

    <div class="dw-faq__list">
      {%- for block in section.blocks -%}
        {%- if block.type == 'question' -%}
          <details class="dw-faq__item" {{ block.shopify_attributes }}>
            <summary class="dw-faq__question">
              <span>{{ block.settings.question | escape }}</span>
              <span class="dw-faq__icon" aria-hidden="true"></span>
            </summary>
            <div class="dw-faq__answer rte">{{ block.settings.answer }}</div>
          </details>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "FAQ accordion",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Field notes"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently asked questions"
    },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding top", "default": 60 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding bottom", "default": 80 }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How long does shipping take?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Answer goes here.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ accordion",
      "blocks": [
        { "type": "question", "settings": { "question": "How long does shipping take?", "answer": "<p>Orders ship within 2–3 business days. Domestic delivery typically takes 4–7 business days.</p>" } },
        { "type": "question", "settings": { "question": "Do you restock sold-out sizes?", "answer": "<p>No — every drop is a limited, numbered run. Once a size sells out, it's gone for that run.</p>" } },
        { "type": "question", "settings": { "question": "What's your return policy?", "answer": "<p>Unworn items in original condition can be returned within 14 days of delivery. See our Returns page for details.</p>" } },
        { "type": "question", "settings": { "question": "How do I know my size?", "answer": "<p>Check the size guide linked on each product page — fits run true to size unless noted.</p>" } }
      ]
    }
  ]
}
{% endschema %}
